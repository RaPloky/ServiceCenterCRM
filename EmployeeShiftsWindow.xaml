<Window x:Class="Service_Store.EmployeeShiftsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графік роботи працівників" Height="500" Width="750"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Ліва панель: Форма додавання/редагування зміни (тільки для адміна) -->
        <Border Grid.Column="0" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,15,0">
            <StackPanel x:Name="pnlAdminControls">
                <TextBlock Text="Керування зміною" FontWeight="Bold" FontSize="14" Margin="0,0,0,15"/>

                <TextBlock Text="Працівник:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <ComboBox x:Name="cbEmployees" Height="30" VerticalContentAlignment="Center" Margin="0,0,0,10" DisplayMemberPath="LastName" SelectedValuePath="EmployeeId"/>

                <TextBlock Text="Дата зміни:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <DatePicker x:Name="dpShiftDate" Height="30" Margin="0,0,0,10"/>

                <TextBlock Text="Початок роботи (напр. 09:00):" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtStartTime" Height="30" VerticalContentAlignment="Center" Text="09:00" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Кінець роботи (напр. 18:00):" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBox x:Name="txtEndTime" Height="30" VerticalContentAlignment="Center" Text="18:00" Padding="5" Margin="0,0,0,10"/>

                <Button Content="Зберегти зміну" Height="40" Background="#007ACC" Foreground="White" FontWeight="Bold" Click="SaveShift_Click"/>
            </StackPanel>
        </Border>

        <!-- Права панель: Таблиця графіків -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Розклад робочих змін" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" Grid.Row="0"/>

            <DataGrid x:Name="dgShifts" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Grid.Row="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding ShiftDate, StringFormat={}{0:yyyy-MM-dd}}" Width="100"/>
                    <DataGridTextColumn Header="Працівник" Binding="{Binding EmployeeName}" Width="140"/>
                    <DataGridTextColumn Header="Час" Binding="{Binding TimeRange}" Width="110"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>