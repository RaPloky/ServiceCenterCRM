<Window x:Class="Service_Store.AddDeviceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новий пристрій" Height="480" Width="400" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- Основна форма з полями -->
            <RowDefinition Height="Auto"/>
            <!-- Рядок для кнопки збереження -->
        </Grid.RowDefinitions>

        <!-- Поля введення -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="Власник (Клієнт):" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cbCustomers" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12" DisplayMemberPath="LastName" SelectedValuePath="CustomerId"/>

            <TextBlock Text="Тип пристрою (Смартфон, Ноутбук тощо):" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtDeviceType" Height="32" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,12"/>

            <TextBlock Text="Бренд:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtBrand" Height="32" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,12"/>

            <TextBlock Text="Модель:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtModel" Height="32" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,12"/>

            <TextBlock Text="Серійний номер (необов'язково):" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtSerialNumber" Height="32" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,5"/>
        </StackPanel>

        <!-- Збільшена кнопка збереження -->
        <Button Grid.Row="1" Content="Зберегти пристрій" Height="45" Background="#28A745" Foreground="White" FontWeight="Bold" Click="SaveDevice_Click" Margin="0,15,0,0"/>
    </Grid>
</Window>