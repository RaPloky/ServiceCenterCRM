<Window x:Class="Service_Store.BonusSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформлення продажу (Каса з бонусами)" Height="650" Width="1300"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.6*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,12,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="1.2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Header="Товар" Grid.Row="0" Margin="0,0,0,10">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="txtProductSearch" Height="30" Margin="0,0,0,8"
                             VerticalContentAlignment="Center" TextChanged="ProductSearch_TextChanged"/>
                    <DataGrid x:Name="dgProducts" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" MouseDoubleClick="Products_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" Width="80"/>
                            <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Артикул" Binding="{Binding Sku}" Width="*"/>
                            <DataGridTextColumn Header="Ціна" Binding="{Binding SalePrice, StringFormat=N2}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <GroupBox Header="Кошик" Grid.Row="1">
                <DataGrid x:Name="dgCart" AutoGenerateColumns="False" IsReadOnly="True"
                          SelectionMode="Single" Margin="8">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Видалити" Click="RemoveCartItem_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Product.ProductId}" Width="70"/>
                        <DataGridTextColumn Header="Назва" Binding="{Binding Product.Name}" Width="*"/>
                        <DataGridTextColumn Header="Кількість" Binding="{Binding Quantity}" Width="100"/>
                        <DataGridTextColumn Header="Ціна" Binding="{Binding Product.SalePrice, StringFormat=N2}" Width="110"/>
                        <DataGridTextColumn Header="Сума" Binding="{Binding Total, StringFormat=N2}" Width="110"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </Grid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <GroupBox Header="Клієнт" Grid.Row="0" Margin="0,0,0,10">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="txtCustomerSearch" Height="30" Margin="0,0,0,8"
                             VerticalContentAlignment="Center" TextChanged="CustomerSearch_TextChanged"/>
                    <DataGrid x:Name="dgCustomers" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                              SelectionMode="Single" MouseDoubleClick="Customers_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Ім'я" Binding="{Binding FirstName}" Width="*"/>
                            <DataGridTextColumn Header="Прізвище" Binding="{Binding LastName}" Width="*"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <Border Grid.Row="1" Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1"
                    CornerRadius="4" Padding="10" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Доступно бонусів у клієнта: " FontWeight="Medium"/>
                    <TextBlock x:Name="txtCustomerBonus" Text="0.00 грн" FontWeight="Bold" Foreground="#28A745"/>
                </StackPanel>
            </Border>

            <StackPanel Grid.Row="2" Margin="0,0,0,15">
                <TextBlock Text="Списати бонусні бали (грн):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtBonusToSpend" Height="32" VerticalContentAlignment="Center" Padding="5"
                         Text="0" TextChanged="TxtBonusToSpend_TextChanged"/>
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock x:Name="txtProductPrice" Text="Сума товарів: 0.00 грн" FontSize="14"/>
                <TextBlock x:Name="txtFinalAmount" Text="До сплати: 0.00 грн" FontSize="18" FontWeight="Bold"
                           Foreground="#007BFF" Margin="0,5,0,0"/>
                <TextBlock x:Name="txtBonusesEarned" Text="Буде нараховано бонусів: 0.00 грн" FontSize="13"
                           Foreground="#28A745" Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Row="4" Content="Підтвердити продаж" Height="45" Background="#28A745"
                    Foreground="White" FontWeight="Bold" Click="CompleteSale_Click"/>
        </Grid>
    </Grid>
</Window>