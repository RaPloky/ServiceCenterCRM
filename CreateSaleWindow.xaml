<Window x:Class="Service_Store.CreateSaleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новий продаж" Height="420" Width="400" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Клієнт (необов'язково):" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cbCustomers" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12" DisplayMemberPath="LastName" SelectedValuePath="CustomerId"/>

            <TextBlock Text="Товар зі складу:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cbProducts" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12" DisplayMemberPath="Product.Name" SelectedValuePath="ProductId"/>

            <TextBlock Text="Кількість:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtQuantity" Height="32" VerticalContentAlignment="Center" Padding="5" Text="1" Margin="0,0,0,12"/>

            <TextBlock Text="Спосіб оплати:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cbPaymentMethod" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,5">
                <ComboBoxItem Content="CASH" IsSelected="True"/>
                <ComboBoxItem Content="CARD"/>
            </ComboBox>
        </StackPanel>

        <Button Grid.Row="1" Content="Оформити продаж" Height="45" Background="#28A745" Foreground="White" FontWeight="Bold" Click="CompleteSale_Click" Margin="0,15,0,0"/>
    </Grid>
</Window>