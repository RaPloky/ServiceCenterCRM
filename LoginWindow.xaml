<Window x:Class="ServiceCenterCRM.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Авторизація - CRM Сервісного Центру" Height="320" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="25">
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Вхід у систему" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Логін:" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <TextBox x:Name="txtUsername" Height="35" Margin="0,0,0,15" Padding="8" VerticalContentAlignment="Center"/>

            <TextBlock Text="Пароль:" Margin="0,0,0,5" FontWeight="SemiBold"/>
            <PasswordBox x:Name="txtPassword" Height="35" Margin="0,0,0,25" Padding="8" VerticalContentAlignment="Center"/>

            <Button Content="Увійти" Height="40" Background="#007ACC" Foreground="White" FontWeight="Bold" FontSize="14" Click="LoginButton_Click"/>
        </StackPanel>
    </Grid>
</Window>