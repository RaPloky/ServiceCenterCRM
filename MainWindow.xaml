<Window x:Class="Service_Center.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CRM Сервісного Центру - Головне меню" Height="550" Width="900" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхня панель (Шапка з інформацією про працівника) -->
        <Border Background="#007ACC" Grid.Row="0">
            <Grid Margin="15,0">
                <TextBlock x:Name="txtUserInfo" Text="Користувач: ..." Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Left"/>
                <Button Content="Вийти" Width="80" Height="28" HorizontalAlignment="Right" Click="Logout_Click"/>
            </Grid>
        </Border>

        <!-- Головне робоче середовище (Вкладки) -->
        <TabControl Grid.Row="1" Margin="10" x:Name="mainTabControl" SelectionChanged="MainTabControl_SelectionChanged">
            <TabItem Header="Дашборд" x:Name="tabDashboard">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Верхня панель з KPI картками -->
                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,0,0,15">
                        <!-- Картка 1: Загальні продажі -->
                        <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Загальна сума продажів" Foreground="#6C757D" FontSize="14"/>
                                <TextBlock x:Name="txtTotalSales" Text="0.00 грн" FontSize="22" FontWeight="Bold" Foreground="#28A745" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Картка 2: Активні ремонти -->
                        <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Усього ремонтів" Foreground="#6C757D" FontSize="14"/>
                                <TextBlock x:Name="txtActiveRepairs" Text="0" FontSize="22" FontWeight="Bold" Foreground="#007BFF" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Картка 3: Дефіцит на складі -->
                        <Border Background="#F8F9FA" BorderBrush="#DEE2E6" BorderThickness="1" CornerRadius="5" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="Товарів мало на складі" Foreground="#6C757D" FontSize="14"/>
                                <TextBlock x:Name="txtLowStock" Text="0" FontSize="22" FontWeight="Bold" Foreground="#DC3545" Margin="0,5,0,0"/>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- Кнопка оновлення даних -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,0,5,10">
                        <Button Content="Оновити дашборд" Width="140" Height="30" Click="LoadDashboard_Click"/>
                    </StackPanel>

                    <!-- Таблиця сповіщень: товари, які закінчуються (менше або дорівнює 3 одиницям) -->
                    <GroupBox Grid.Row="2" Header="Увага: товари на вичерпанні (залишок &lt;= 3)" Margin="5" Padding="5">
                        <DataGrid x:Name="dgLowStock" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Товар" Binding="{Binding Product.Name}" Width="220"/>
                                <DataGridTextColumn Header="SKU" Binding="{Binding Product.Sku}" Width="130"/>
                                <DataGridTextColumn Header="Залишок" Binding="{Binding Quantity}" Width="100"/>
                                <DataGridTextColumn Header="Розташування" Binding="{Binding Location}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>
            <TabItem Header="Ремонти (СЦ)" x:Name="tabRepairs">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель дій -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Оновити список" Width="120" Height="30" Margin="0,0,10,0" Click="LoadRepairs_Click"/>
                        <Button Content="+ Новий ремонт" Width="130" Height="30" Background="#28A745" Foreground="White" FontWeight="Bold" Click="AddRepair_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Оновити список" Width="120" Height="30" Click="LoadRepairs_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Оновити список" Width="130" Height="30" Margin="0,0,10,0" Click="LoadRepairs_Click"/>
                        <Button Content="+ Новий ремонт" Width="130" Height="30" Margin="0,0,10,0" Background="#28A745" Foreground="White" FontWeight="Bold" Click="AddRepair_Click"/>
                        <Button Content="Редагувати / Статус" Width="150" Height="30" Background="#007ACC" Foreground="White" FontWeight="Bold" Click="EditRepair_Click"/>
                    </StackPanel>


                    <!-- Таблиця для виведення ремонтів -->
                    <DataGrid x:Name="dgRepairs" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding RepairId}" Width="50"/>
                            <DataGridTextColumn Header="Номер квитанції" Binding="{Binding RepairNumber}" Width="130"/>
                            <DataGridTextColumn Header="Опис несправності" Binding="{Binding CustomerDescription}" Width="*"/>
                            <DataGridTextColumn Header="Дата прийому" Binding="{Binding ReceivedAt}" Width="150"/>
                            <DataGridTextColumn Header="Орієнтовна ціна" Binding="{Binding EstimatedPrice}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Продажі" x:Name="tabSales">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Оновити історію" Width="140" Height="30" Margin="0,0,10,0" Click="LoadSales_Click"/>
                        <Button Content="+ Новий продаж" Width="140" Height="30" Background="#28A745" Foreground="White" FontWeight="Bold" Click="AddSale_Click"/>
                    </StackPanel>

                    <DataGrid x:Name="dgSales" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding SaleId}" Width="40"/>
                            <DataGridTextColumn Header="Номер чека" Binding="{Binding SaleNumber}" Width="130"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding SaleDate, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
                            <DataGridTextColumn Header="Клієнт" Binding="{Binding Customer.LastName}" Width="150"/>
                            <DataGridTextColumn Header="Використано бонусів" Binding="{Binding BonusUsed}" Width="130"/>
                            <DataGridTextColumn Header="Сума (грн)" Binding="{Binding TotalAmount}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Магазин / Продажі" x:Name="tabStore">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель дій магазину -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Оновити каталог" Width="130" Height="30" Margin="0,0,10,0" Click="LoadProducts_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Оновити каталог" Width="130" Height="30" Margin="0,0,10,0" Click="LoadProducts_Click"/>
                        <Button Content="Продати обраний товар" Width="160" Height="30" Background="#28A745" Foreground="White" FontWeight="Bold" Click="CreateSale_Click"/>
                    </StackPanel>

                    <!-- Таблиця товарів -->
                    <DataGrid x:Name="dgProducts" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" Width="50"/>
                            <DataGridTextColumn Header="Артикул (SKU)" Binding="{Binding Sku}" Width="130"/>
                            <DataGridTextColumn Header="Назва товару" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="Ціна (грн)" Binding="{Binding SalePrice}" Width="120"/>
                            <DataGridTextColumn Header="Гарантія (міс.)" Binding="{Binding WarrantyMonths}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Клієнти" x:Name="tabCustomers">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель дій -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Оновити список" Width="130" Height="30" Margin="0,0,10,0" Click="LoadCustomers_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Оновити список" Width="130" Height="30" Margin="0,0,10,0" Click="LoadCustomers_Click"/>
                        <Button Content="+ Новий клієнт" Width="130" Height="30" Background="#28A745" Foreground="White" FontWeight="Bold" Click="AddCustomer_Click"/>
                    </StackPanel>

                    <!-- Таблиця клієнтів -->
                    <DataGrid x:Name="dgCustomers" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding CustomerId}" Width="50"/>
                            <DataGridTextColumn Header="Прізвище" Binding="{Binding LastName}" Width="120"/>
                            <DataGridTextColumn Header="Ім'я" Binding="{Binding FirstName}" Width="120"/>
                            <DataGridTextColumn Header="По батькові" Binding="{Binding MiddleName}" Width="120"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="130"/>
                            <DataGridTextColumn Header="Бонуси (грн)" Binding="{Binding BonusBalance}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Склад" x:Name="tabWarehouse">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель дій складу -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Оновити залишки" Width="140" Height="30" Margin="0,0,10,0" Click="LoadWarehouse_Click"/>
                    </StackPanel>

                    <!-- Таблиця залишків -->
                    <DataGrid x:Name="dgWarehouse" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding StockId}" Width="40"/>
                            <DataGridTextColumn Header="Склад" Binding="{Binding WarehouseId}" Width="60"/>
                            <DataGridTextColumn Header="Назва товару" Binding="{Binding Product.Name}" Width="*"/>
                            <DataGridTextColumn Header="SKU" Binding="{Binding Product.Sku}" Width="120"/>
                            <DataGridTextColumn Header="Кількість" Binding="{Binding Quantity}" Width="80"/>
                            <DataGridTextColumn Header="У резерві" Binding="{Binding ReservedQuantity}" Width="80"/>
                            <DataGridTextColumn Header="Мінімум" Binding="{Binding MinimumQuantity}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Пристрої клієнтів" x:Name="tabDevices">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель дій -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Оновити список" Width="140" Height="30" Click="LoadDevices_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Оновити список" Width="140" Height="30" Margin="0,0,10,0" Click="LoadDevices_Click"/>
                        <Button Content="+ Новий пристрій" Width="140" Height="30" Background="#28A745" Foreground="White" FontWeight="Bold" Click="AddDevice_Click"/>
                    </StackPanel>

                    <!-- Таблиця пристроїв -->
                    <DataGrid x:Name="dgDevices" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding DeviceId}" Width="40"/>
                            <DataGridTextColumn Header="Тип" Binding="{Binding DeviceType}" Width="100"/>
                            <DataGridTextColumn Header="Бренд" Binding="{Binding Brand}" Width="100"/>
                            <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="130"/>
                            <DataGridTextColumn Header="Серійний номер" Binding="{Binding SerialNumber}" Width="140"/>
                            <DataGridTextColumn Header="Власник (Клієнт)" Binding="{Binding Customer.LastName}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
            <TabItem Header="Постачальники" x:Name="tabSuppliers">
                <TabControl Margin="5">
                    <!-- Підвкладка 1: Компанії-постачальники -->
                    <TabItem Header="Компанії">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Оновити список" Width="140" Height="30" Margin="0,0,10,0" Click="LoadSuppliersList_Click"/>
                                <Button Content="+ Новий постачальник" Width="150" Height="30" Background="#28A745" Foreground="White" FontWeight="Bold" Click="AddSupplier_Click"/>
                            </StackPanel>

                            <DataGrid x:Name="dgSuppliers" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding SupplierId}" Width="40"/>
                                    <DataGridTextColumn Header="Компанія" Binding="{Binding CompanyName}" Width="160"/>
                                    <DataGridTextColumn Header="Контактна особа" Binding="{Binding ContactPerson}" Width="140"/>
                                    <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="130"/>
                                    <DataGridTextColumn Header="Адреса" Binding="{Binding Address}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>

                    <!-- Підвкладка 2: Прайс-лист товарів -->
                    <TabItem Header="Прайс-лист товарів">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Оновити прайс" Width="140" Height="30" Click="LoadSuppliers_Click"/>
                            </StackPanel>

                            <DataGrid x:Name="dgSupplierProducts" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Постачальник" Binding="{Binding Supplier.CompanyName}" Width="150"/>
                                    <DataGridTextColumn Header="Товар" Binding="{Binding Product.Name}" Width="200"/>
                                    <DataGridTextColumn Header="SKU" Binding="{Binding Product.Sku}" Width="120"/>
                                    <DataGridTextColumn Header="Закупівельна ціна (грн)" Binding="{Binding PurchasePrice}" Width="140"/>
                                    <DataGridTextColumn Header="Доставка (днів)" Binding="{Binding DeliveryDays}" Width="110"/>
                                    <DataGridCheckBoxColumn Header="В наявності" Binding="{Binding IsAvailable}" Width="90"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
            <!-- Вкладка адміністратора, яку ми будемо ховати для звичайних ролей -->
            <TabItem Header="Адміністрування" x:Name="tabAdmin">
                <TabControl Margin="5">
                    <!-- Підвкладка: Облік зарплат -->
                    <TabItem Header="Зарплати">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Оновити історію" Width="140" Height="30" Margin="0,0,10,0" Click="LoadSalaries_Click"/>
                                <Button Content="+ Виплата зарплати" Width="160" Height="30" Background="#28A745" Foreground="White" FontWeight="Bold" Click="AddSalary_Click"/>
                                <Button Content="Графік роботи" Width="130" Height="30" Margin="5,0,0,0" Click="OpenShifts_Click"/>
                            </StackPanel>

                            <DataGrid x:Name="dgSalaries" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding RecordId}" Width="40"/>
                                    <DataGridTextColumn Header="Працівник" Binding="{Binding Employee.LastName}" Width="130"/>
                                    <DataGridTextColumn Header="Сума (грн)" Binding="{Binding Amount}" Width="100"/>
                                    <DataGridTextColumn Header="Період" Binding="{Binding Period}" Width="110"/>
                                    <DataGridTextColumn Header="Дата виплати" Binding="{Binding PaymentDate}" Width="140"/>
                                    <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </TabItem>
        </TabControl>
    </Grid>
</Window>