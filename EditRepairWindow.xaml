<Window x:Class="Service_Store.EditRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Керування ремонтом та логування" Height="650" Width="550" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Номер квитанції -->
                <TextBlock Text="Номер квитанції:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBlock x:Name="txtRepairNumber" FontWeight="Bold" Foreground="#007ACC" FontSize="14" Margin="0,0,0,10"/>

                <!-- Статус ремонту -->
                <TextBlock Text="Статус ремонту:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cbStatuses" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10" DisplayMemberPath="Name" SelectedValuePath="StatusId"/>

                <!-- Відповідальний інженер -->
                <TextBlock Text="Відповідальний інженер:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cbAssignedEmployee" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10" DisplayMemberPath="LastName" SelectedValuePath="EmployeeId"/>

                <!-- Опис проблеми клієнтом -->
                <TextBlock Text="Опис проблеми (від клієнта):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtCustomerDescription" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Padding="5" Margin="0,0,0,10"/>

                <!-- Внутрішні нотатки майстра -->
                <TextBlock Text="Внутрішні нотатки майстра:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtInternalNotes" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Padding="5" Margin="0,0,0,10"/>

                <!-- Орієнтовна ціна -->
                <TextBlock Text="Орієнтовна ціна (грн):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEstimatedPrice" Height="30" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,10"/>

                <!-- Фінальна ціна -->
                <TextBlock Text="Фінальна ціна (грн):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtFinalPrice" Height="30" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,10"/>

                <!-- Коментар до зміни статусу (для логу) -->
                <TextBlock Text="Коментар до зміни статусу (для історій):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtLogComment" Height="35" TextWrapping="Wrap" Padding="5" Margin="0,0,0,15"/>

                <!-- Таблиця історії статусів -->
                <TextBlock Text="Історія зміни статусів:" FontWeight="Bold" Margin="0,0,0,5"/>
                <DataGrid x:Name="dgRepairHistory" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="120">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="130"/>
                        <DataGridTextColumn Header="Працівник" Binding="{Binding EmployeeName}" Width="130"/>
                        <DataGridTextColumn Header="Коментар" Binding="{Binding Comment}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопка збереження -->
        <Button Grid.Row="1" Content="Зберегти зміни та зафіксувати лог" Height="45" Background="#28A745" Foreground="White" FontWeight="Bold" Click="SaveRepair_Click" Margin="0,15,0,0"/>
    </Grid>
</Window>