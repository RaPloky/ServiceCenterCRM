<Window x:Class="Service_Store.EditRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Керування ремонтом та логування" Height="682.5" Width="577.5" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Номер квитанції:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBlock x:Name="txtRepairNumber" FontWeight="Bold" Foreground="#007ACC" FontSize="14" Margin="0,0,0,10"/>

                <TextBlock Text="Пристрій:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                <TextBlock x:Name="txtDeviceName" Foreground="#555555" Margin="0,0,0,10"/>

                <TextBlock Text="Статус ремонту:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cbStatuses" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10" DisplayMemberPath="Name" SelectedValuePath="StatusId"/>

                <TextBlock Text="Відповідальний інженер:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="cbAssignedEmployee" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,10" DisplayMemberPath="LastName" SelectedValuePath="EmployeeId"/>

                <GroupBox Header="Використані запчастини / матеріали" Margin="0,15,0,10" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="130"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="100"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBox x:Name="txtRepairPartSearch" Grid.Row="0" Height="28"
                                 VerticalContentAlignment="Center" Margin="0,0,0,8"
                                 ToolTip="Пошук за ID або назвою запчастини"
                                 TextChanged="RepairPartSearch_TextChanged"/>

                        <DataGrid x:Name="dgAvailableRepairParts" Grid.Row="1" AutoGenerateColumns="False"
                                  CanUserAddRows="False" IsReadOnly="True"
                                  MouseDoubleClick="AvailableRepairParts_MouseDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding ProductId}" Width="60"/>
                                <DataGridTextColumn Header="Назва" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="Залишок" Binding="{Binding AvailableQuantity}" Width="90"/>
                                <DataGridTextColumn Header="Ціна" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal" Grid.Row="2" Margin="0,8,0,8">
                            <TextBlock Text="К-сть:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                            <TextBox x:Name="txtPartQuantity" Text="1" Width="40" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,0"/>
                            <TextBlock Text="Подвійне натискання додає запчастину" VerticalAlignment="Center" Foreground="Gray"/>
                        </StackPanel>

                        <DataGrid x:Name="dgRepairParts" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Назва запчастини" Binding="{Binding Name}" Width="200"/>
                                <DataGridTextColumn Header="Кількість" Binding="{Binding Quantity}" Width="80"/>
                                <DataGridTextColumn Header="Ціна за од. (грн)" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="110"/>
                                <DataGridTextColumn Header="Сума (грн)" Binding="{Binding TotalPrice, StringFormat={}{0:N2}}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Button Content="Видалити обрану запчастину" Width="180" Height="30" Background="#DC3545" Foreground="White" FontWeight="Bold" Grid.Row="4" HorizontalAlignment="Right" Margin="0,8,0,0" Click="DeleteRepairPart_Click"/>
                    </Grid>
                </GroupBox>

                <TextBlock Text="Опис проблеми (від клієнта):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtCustomerDescription" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Padding="5" Margin="0,0,0,10"/>

                <GroupBox Header="Фотографії та акти пристрою" Margin="0,15,0,10" Padding="10">
                    <StackPanel>
                        <ListBox x:Name="lstAttachments" Height="90" Margin="0,0,0,10" 
                 DisplayMemberPath="FilePath" 
                 MouseDoubleClick="LstAttachments_MouseDoubleClick"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Додати фото/файл" Width="130" Height="30" Background="#17A2B8" Foreground="White" FontWeight="Bold" Click="AddAttachment_Click" Margin="0,0,10,0"/>
                            <Button Content="Видалити обране" Width="130" Height="30" Background="#DC3545" Foreground="White" FontWeight="Bold" Click="DeleteAttachment_Click"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <TextBlock Text="Внутрішні нотатки майстра:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtInternalNotes" Height="50" AcceptsReturn="True" TextWrapping="Wrap" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Орієнтовна ціна (грн):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtEstimatedPrice" Height="30" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Фінальна ціна (грн):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtFinalPrice" Height="30" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,10"/>

                <TextBlock Text="Коментар до зміни статусу (для історій):" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="txtLogComment" Height="35" TextWrapping="Wrap" Padding="5" Margin="0,0,0,15"/>

                <TextBlock Text="Історія зміни статусів:" FontWeight="Bold" Margin="0,0,0,5"/>
                <DataGrid x:Name="dgRepairHistory" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="120">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt}" Width="130"/>
                        <DataGridTextColumn Header="Працівник" Binding="{Binding EmployeeName}" Width="130"/>
                        <DataGridTextColumn Header="Коментар" Binding="{Binding Comment}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
                <Button Content="🖨 Друк акта робіт" Width="150" Height="30" 
        Background="#17A2B8" Foreground="White" FontWeight="Bold" 
        Click="PrintAct_Click" Margin="0,0,10,0"/>
            </StackPanel>
        </ScrollViewer>

        <Button Grid.Row="1" Content="Зберегти зміни та зафіксувати лог" Height="45" Background="#28A745" Foreground="White" FontWeight="Bold" Click="SaveRepair_Click" Margin="0,15,0,0"/>
    </Grid>
</Window>