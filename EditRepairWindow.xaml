<Window x:Class="Service_Store.EditRepairWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Керування ремонтом" Height="460" Width="420" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Номер квитанції:" FontWeight="SemiBold" Margin="0,0,0,3"/>
            <TextBlock x:Name="txtRepairNumber" FontWeight="Bold" Foreground="#007ACC" FontSize="14" Margin="0,0,0,10"/>

            <TextBlock Text="Статус ремонту:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ComboBox x:Name="cbStatuses" Height="32" VerticalContentAlignment="Center" Margin="0,0,0,12" DisplayMemberPath="Name" SelectedValuePath="StatusId"/>

            <TextBlock Text="Внутрішні нотатки майстра:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtInternalNotes" Height="60" AcceptsReturn="True" TextWrapping="Wrap" Padding="5" Margin="0,0,0,12"/>

            <TextBlock Text="Фінальна ціна (грн):" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtFinalPrice" Height="32" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,5"/>
        </StackPanel>

        <Button Grid.Row="1" Content="Зберегти зміни" Height="45" Background="#28A745" Foreground="White" FontWeight="Bold" Click="SaveRepair_Click" Margin="0,15,0,0"/>
    </Grid>
</Window>