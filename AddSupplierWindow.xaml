<Window x:Class="Service_Store.AddSupplierWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новий постачальник" Height="380" Width="400" 
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Назва компанії:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtCompanyName" Height="32" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,12"/>

            <TextBlock Text="Контактна особа:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtContactPerson" Height="32" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,12"/>

            <TextBlock Text="Телефон:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtPhone" Height="32" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,12"/>

            <TextBlock Text="Адреса:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <TextBox x:Name="txtAddress" Height="32" VerticalContentAlignment="Center" Padding="5" Margin="0,0,0,5"/>
        </StackPanel>

        <Button Grid.Row="1" Content="Зберегти постачальника" Height="45" Background="#28A745" Foreground="White" FontWeight="Bold" Click="SaveSupplier_Click" Margin="0,15,0,0"/>
    </Grid>
</Window>